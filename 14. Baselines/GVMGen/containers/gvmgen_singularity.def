Bootstrap: docker
From: nvcr.io/nvidia/pytorch:23.10-py3

%files
    "/home/es119256/dados/repos/vmdb/14. Baselines/GVMGen/containers/requirements.txt" "/root/requirements.txt"

%environment
    # Make conda available at runtime
    export PATH=/root/miniconda3/bin:$PATH
    export CONDA_AUTO_ACTIVATE_BASE=false

%post
    #!/bin/bash
    set -xeuo pipefail

    echo "=== System info ==="
    df -h

    echo "=== Installing system dependencies ==="
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    apt-get update
    apt-get -y upgrade

    apt-get install -y build-essential

    echo "=== Installing Miniconda (Python 3.9) ==="
    mkdir -p /root/miniconda3
    wget https://repo.anaconda.com/miniconda/Miniconda3-py39_25.3.1-1-Linux-x86_64.sh -O /root/miniconda3/miniconda.sh
    bash /root/miniconda3/miniconda.sh -b -u -p /root/miniconda3
    rm /root/miniconda3/miniconda.sh

    # Activate conda explicitly under bash
    source /root/miniconda3/bin/activate

    echo "=== Conda configuration ==="
    conda config --set channel_priority strict

    echo "=== Conda AV ==="
    conda install -y av==11.0.0 -c conda-forge

    echo "=== Python setuptools wheel ==="
    python3 -m pip install setuptools wheel

    echo "=== PyTorch 2.1 ==="
    python -m pip install 'torch==2.1.0'

    echo "=== Requirements as imported in %files ==="
    python3 -m pip install -r /root/requirements.txt

    # Apex breaks fairseq — explicitly remove it
    python3 -m pip uninstall -y apex || true

    echo "=== Clean useless files ==="
    rm /root/requirements.txt
    conda clean --all

    echo "=== Build completed successfully ==="

%test
    #!/bin/bash
    set -xeuo pipefail

    echo "=== PATH ==="
    echo "$PATH"

    echo "=== Conda environments ==="
    source /root/miniconda3/bin/activate
    conda env list

    echo "=== Torch check ==="
python3 - <<'EOF'
import torch
print("Torch version:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())
EOF

%runscript
    #!/bin/bash
    # Default runtime behavior
    source /root/miniconda3/bin/activate
    exec "$@"
